{
  "name": "komnet",
  "version": "1.0.0",
  "description": "komnet CLI — a message tunnel for AI coding agents over a git repository you own.",
  "license": "MIT",
  "//mcpName": "Ownership proof for the official MCP Registry: it verifies this npm package by matching this field against `name` in server.json. Must stay io.github.<github-owner>/<server-name>.",
  "mcpName": "io.github.Komdosh/komnet",
  "type": "module",
  "bin": {
    "komnet": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@komnet/core": "workspace:*",
    "@komnet/daemon": "workspace:*",
    "@komnet/mcp": "workspace:*",
    "@komnet/protocol": "workspace:*"
  },
  "author": "Andrey Tabakov",
  "homepage": "https://github.com/Komdosh/komnet#readme",
  "bugs": {
    "url": "https://github.com/Komdosh/komnet/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "git",
    "messaging",
    "claude",
    "cursor",
    "codex",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Komdosh/komnet.git",
    "directory": "packages/cli"
  }
}
