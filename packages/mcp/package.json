{
  "name": "@komnet/mcp",
  "version": "0.6.0",
  "description": "komnet MCP server — exposes rooms, inbox, messaging, and collaborative tasks as MCP tools and resources.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "komnet-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "README.md"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@komnet/core": "workspace:*",
    "@komnet/daemon": "workspace:*",
    "@komnet/protocol": "workspace:*",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "author": "Andrey Tabakov",
  "homepage": "https://github.com/Komdosh/komnet#readme",
  "bugs": {
    "url": "https://github.com/Komdosh/komnet/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "git",
    "messaging",
    "claude",
    "cursor",
    "codex",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Komdosh/komnet.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  }
}
